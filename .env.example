GITHUB_TOKEN=ghp_xxx_replace_me
GITHUB_REPO=vllm-project/vllm
DB_PATH=./data/insights.sqlite
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-haiku-4-5

# Alibaba Bailian / DashScope (OpenAI-compatible). When DASHSCOPE_API_KEY is set,
