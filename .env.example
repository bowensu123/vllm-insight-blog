GITHUB_TOKEN=ghp_xxx_replace_me
GITHUB_REPO=vllm-project/vllm
DB_PATH=./data/insights.sqlite
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-haiku-4-5

# Alibaba Bailian / DashScope (OpenAI-compatible). When DASHSCOPE_API_KEY is set,
# the LLM digest auto-uses the `bailian` backend (model defaults to qwen3.7-max).
DASHSCOPE_API_KEY=sk-xxx
LLM_MODEL=qwen3.7-max
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Private SMTP delivery of the weekly digest (vllm-insights email-digest). Sends
# straight to your mailbox — nothing public, no one else notified. Set all four
# required vars (as GitHub repo secrets in CI). Common relays:
#   QQ:      smtp.qq.com    465 ssl    (password = 授权码, not your login pw)
#   163:     smtp.163.com   465 ssl    (password = 授权码)
#   Gmail:   smtp.gmail.com 587 starttls (password = App Password)
#   Outlook: smtp.office365.com 587 starttls
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# SMTP_SECURITY=ssl            # ssl (default @465) | starttls (default @587) | plain
SMTP_USERNAME=your_account@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
# MAIL_FROM defaults to SMTP_USERNAME
MAIL_TO=subowen5@huawei.com
